# Copy to .env.local and fill in. Never commit real secrets (.env* is git-ignored, this file is the exception).

# --- Browser + server (NEXT_PUBLIC_* is sent to the browser: only public values here) ---
NEXT_PUBLIC_SUPABASE_URL=https://ibubxterxwmgqospjmxi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=            # Phase 2: Maps JavaScript + Places (New) + Geocoding, referrer-restricted
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=             # Phase 2: vector Map ID (needed for advanced markers)

# --- Server only ---
SUPABASE_SECRET_KEY=sb_secret_...           # admin client (webhooks, account deletion). Never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...               # Phase 5
STRIPE_WEBHOOK_SECRET=whsec_...             # Phase 5: platform endpoint /api/stripe/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...     # Phase 5: connected-accounts endpoint /api/stripe/connect-webhook
STRIPE_FEE_PERCENT=0                        # Pocket's fee on card payments, deducted from the helper's half. Set before launch.

# --- Local only: Supabase CLI (db push, gen types, config push). Not needed on Vercel. ---
SUPABASE_ACCESS_TOKEN=sbp_...               # a scoped personal access token for this project
SUPABASE_DB_PASSWORD=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=     # the Apple Services ID
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=        # client-secret JWT from the .p8 key; expires every 6 months
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=no-reply@your-domain
